    {
      "dot": "emerald",
      "title": "Modular monolith",
      "items": [
        "One deployable unit; cross-module calls only through each module's api/",
        "Identity assigns roles server-side; track (Python/SQL) is a preference, not a privilege"
      ]
    },
    {
      "dot": "amber",
      "title": "Sandboxed execution",
      "items": [
        "Runner accepts a closed request schema only \u2014 no paths or container args from callers (SR-01)",
        "Learner code runs in a container with no network, read-only root, dropped capabilities, and is destroyed after each run"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and evidence",
      "items": [
        "Score updates only after all four levels pass and the ledger verifies",
