   "id": "py-l2-01",
   "kind": "python",
   "competency": "python",
   "title": "Average of a list",
   "prompt": "average(nums) should return the arithmetic mean of a list of numbers, or 0.0 for an empty list. It returns wrong values. Find the error, fix the code and explain what was wrong.",
   "function": "average",
   "broken_code": "def average(nums):\n    total = 0\n    for n in nums:\n        total += n\n    return total / (len(nums) + 1)\n",
   "datasets": [
    {
     "name": "v1",
     "tests": [
      {
       "id": "t1",
       "args": [
        [
         1,
         2,
         3
        ]
       ],
       "expected": 2.0
      },
      {
       "id": "t2",
       "args": [
        []
       ],
       "expected": 0.0
      },
      {
       "id": "t3",
       "args": [
        [
         10
        ]
       ],
       "expected": 10.0
      },
      {
       "id": "t4",
       "args": [
        [
         2,
         4,
         6,
         8
        ]
       ],
       "expected": 5.0
      }
     ]
    },
    {
     "name": "v2",
     "tests": [
      {
       "id": "t1",
       "args": [
        [
         5,
         5
        ]
       ],
       "expected": 5.0
      },
      {
       "id": "t2",
       "args": [
        []
       ],
       "expected": 0.0
      },
      {
       "id": "t3",
       "args": [
        [
         -1,
         1,
         3
        ]
       ],
       "expected": 1.0
      },
      {
       "id": "t4",
       "args": [
        [
         0.5,
         1.5
        ]
       ],
       "expected": 1.0
      }
     ]
    }
   ],
